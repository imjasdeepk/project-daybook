# Your actual records. These stay private and are versioned in their own
# repository inside ledger/ and notes/, so this repo can be published safely.
# Anchored to the root: unanchored, these also swallowed .claude/skills/ledger/
# and would swallow .claude/skills/notes/.
/ledger/
/notes/

# Local mdloop review state, specific to one machine.
.mdloop/

.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
*.egg-info/

# Points at wherever your records live. Personal to this machine.
# Both spellings: .ledger-root predates the rename and is still honoured.
.daybook-root
.ledger-root
.notes-root
